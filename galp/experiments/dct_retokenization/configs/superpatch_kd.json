{
  "schema": "dct-superpatch-training-config-v1",
  "stage": "stage_kd",
  "method": "DCT Super-Patch Projection with logit distillation",
  "k": 32,
  "token_count": 98,
  "merge_axis": "width",
  "initialization": "keep_first",
  "position_mode": "superpatch_center",
  "epochs": 3,
  "unfrozen_last_blocks": 4,
  "physical_batch_size": 64,
  "gradient_accumulation": 16,
  "effective_batch_size": 1024,
  "learning_rates": {
    "tokenizer": 0.00005,
    "head": 0.000015,
    "last_blocks": 0.000005
  },
  "weight_decay": {
    "tokenizer": 0.0001,
    "head": 0.00001,
    "last_blocks": 0.00001
  },
  "warmup_updates": 50,
  "betas": [0.9, 0.999],
  "epsilon": 1e-8,
  "gradient_clip_norm": 1.0,
  "scheduler": "differential_warmup_then_cosine",
  "distillation": {
    "teacher": "K32/N196 pretrained checkpoint",
    "temperature": 2.0,
    "lambda": 1.0,
    "feature_loss": false
  },
  "crop": "published deterministic per-sample RandomResizedCrop_DCT",
  "horizontal_flip_probability": 0.5,
  "randaugment": false,
  "mixup_alpha": 0.0,
  "seed": 11997733
}
