diff --git a/cmake/modules/FindNVJPEG.cmake b/cmake/modules/FindNVJPEG.cmake
index af11a38..4f45eeb 100644
--- a/cmake/modules/FindNVJPEG.cmake
+++ b/cmake/modules/FindNVJPEG.cmake
@@ -20,11 +20,13 @@ find_library(NVJPEG_LIBRARY libnvjpeg_static.a nvjpeg
     PATHS ${NVJPEG_ROOT_DIR} ${CUDA_TOOLKIT_ROOT_DIR}
     PATH_SUFFIXES lib lib64)
 
-# nvJPEG 9.0 calls itself 0.1.x via API calls, and the header file doesn't tell you which
-# version it is. There's not a super clean way to determine which CUDA's nvJPEG we have.
-execute_process(COMMAND strings ${NVJPEG_LIBRARY} COMMAND grep /toolkit/
-                COMMAND sed "s;^.*toolkit/r\\(\[^/\]\\+\\\).*$;\\1;" COMMAND sort -u
-                OUTPUT_STRIP_TRAILING_WHITESPACE OUTPUT_VARIABLE NVJPEG_VERSION)
+# Current nvJPEG headers publish their version directly.
+file(STRINGS "${NVJPEG_INCLUDE_DIR}/nvjpeg.h" NVJPEG_VERSION_LINES REGEX "^#define NVJPEG_VER_(MAJOR|MINOR|PATCH) ")
+foreach(part MAJOR MINOR PATCH)
+  string(REGEX MATCH "NVJPEG_VER_${part} +([0-9]+)" match "${NVJPEG_VERSION_LINES}")
+  set(NVJPEG_${part} "${CMAKE_MATCH_1}")
+endforeach()
+set(NVJPEG_VERSION "${NVJPEG_MAJOR}.${NVJPEG_MINOR}.${NVJPEG_PATCH}")
 
 include(FindPackageHandleStandardArgs)
 find_package_handle_standard_args(NVJPEG
