{
  "schema": "dct-retokenization-training-config-v1",
  "stage": "adapter",
  "epochs": 20,
  "physical_batch_size": 64,
  "gradient_accumulation": 16,
  "effective_batch_size": 1024,
  "learning_rate": 0.003,
  "weight_decay": 0.0001,
  "warmup_updates": 1000,
  "optimizer": "AdamW",
  "betas": [0.9, 0.999],
  "epsilon": 1e-8,
  "gradient_clip_norm": 1.0,
  "scheduler": "warmup_then_cosine",
  "mixup_alpha": 0.2,
  "randaugment_operations": 2,
  "randaugment_magnitude": 3,
  "crop": "RandomResizedCrop_DCT(28,scale=(0.05,1.0),ratio=(1,1))",
  "horizontal_flip_probability": 0.5,
  "seed": 11997733,
  "token_count": 98,
  "merge_axis": "width",
  "merge_type": "learned",
  "trainable": ["retokenization_adapter"],
  "checkpoint_epochs": [1, 5, 10, 20]
}
